# PyPlayVNC environment — copy to .env and fill in your values.
# cp .env.example .env

# ── Display ───────────────────────────────────────────────────
DISPLAY=:99
USER_DATA_DIR=/app/user_data
SCREEN_RES=1280x1024x24

# ── Manager Auth ──────────────────────────────────────────────
# SHA-256 hash of your API key. The raw key is never stored here.
#
# Generate a key pair:
#   python3 -c "import secrets,hashlib; k=secrets.token_urlsafe(32); print('RAW:',k); print('HASH:',hashlib.sha256(k.encode()).hexdigest())"
#
# Store the RAW key in your password manager / AI agent config.
# Put only the HASH value below.
API_KEY_HASH=your-sha256-hash-here
