# Copy to .env only if you are not using `pyplayvnc init`.
# Generate a high-entropy key and store only its SHA-256 digest here.
API_KEY_HASH=replace-with-64-character-sha256-hex-digest

SCREEN_RES=1280x1024x24

# The VNC password is a separate local secret file:
#   mkdir -p secrets && chmod 700 secrets
#   python3 -c 'import secrets; print(secrets.token_urlsafe(18))' > secrets/vnc_password
#   chmod 600 secrets/vnc_password
