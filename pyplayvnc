#!/usr/bin/env bash
# pyplayvnc — container lifecycle helper
#
# Usage:
#   pyplayvnc up          Start containers (idempotent)
#   pyplayvnc down        Stop and remove containers (profiles preserved)
#   pyplayvnc status      Show container state + persona status
#   pyplayvnc open <name> Open browser for a persona (requires API key in env)
#   pyplayvnc kill <name> Kill browser for a persona
#   pyplayvnc logs        Tail manager logs
#
# Set PYPLAYVNC_KEY in your shell profile or pass inline:
#   PYPLAYVNC_KEY=xxx pyplayvnc status

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="${PYPLAYVNC_HOST:-localhost}"
PORT="${PYPLAYVNC_PORT:-8888}"
KEY="${PYPLAYVNC_KEY:-}"
BASE="http://${HOST}:${PORT}"

_api() {
    local method="$1" path="$2"
    shift 2
    if [ -z "$KEY" ]; then
        echo "Error: set PYPLAYVNC_KEY env var to your API key" >&2
        exit 1
    fi
    curl -sf -X "$method" -H "X-API-Key: $KEY" "$@" "${BASE}${path}"
}

cmd="${1:-help}"

case "$cmd" in
    up)
        echo "▶  Starting PyPlayVNC..."
        cd "$REPO_DIR"
        docker compose up -d
        echo ""
        echo "✓  Manager UI: http://${HOST}:${PORT}"
        echo "✓  VNC:        ${HOST}:5900  (use any VNC viewer)"
        ;;

    down)
        echo "■  Stopping PyPlayVNC (profiles preserved)..."
        cd "$REPO_DIR"
        docker compose down
        echo "✓  Stopped"
        ;;

    status)
        echo "=== Containers ==="
        docker ps --filter "name=playwright_vnc" --filter "name=persona_manager" \
            --format "  {{.Names}}  {{.Status}}" 2>/dev/null || echo "  (not running)"
        echo ""
        echo "=== Personas ==="
        _api GET /api/personas | python3 -c "
import sys, json
personas = json.load(sys.stdin)
for p in personas:
    status = '🟢 running' if p.get('browser_running') else ('✓ session' if p.get('has_session') else '○ no session')
    print(f\"  {p['name']:<20} {status}\")
" 2>/dev/null || echo "  (manager not ready)"
        ;;

    open)
        name="${2:-default}"
        url="${3:-https://mail.google.com}"
        echo "▶  Opening browser for persona: $name"
        result=$(_api POST "/api/personas/${name}/launch?url=${url}")
        echo "$result" | python3 -c "
import sys, json
r = json.load(sys.stdin)
print(f\"  Status: {r.get('status')}  PID: {r.get('pid')}\")
print(f\"  Connect VNC: ${HOST}:5900\")
"
        ;;

    kill)
        name="${2:-default}"
        echo "■  Killing browser for persona: $name"
        _api POST "/api/personas/${name}/kill" | python3 -c "
import sys, json
r = json.load(sys.stdin)
print(f\"  {r}\")
"
        ;;

    logs)
        cd "$REPO_DIR"
        docker compose logs -f manager
        ;;

    *)
        cat << 'HELP'
pyplayvnc — persona browser manager

Usage:
  pyplayvnc up               Start containers
  pyplayvnc down             Stop containers (profiles preserved)
  pyplayvnc status           Show container + persona status
  pyplayvnc open [name] [url]  Open browser for persona (default: default)
  pyplayvnc kill [name]      Kill browser for persona
  pyplayvnc logs             Tail manager logs

Environment:
  PYPLAYVNC_KEY    API key (required for open/kill/status)
  PYPLAYVNC_HOST   Manager host (default: localhost)
  PYPLAYVNC_PORT   Manager port (default: 8888)

Examples:
  pyplayvnc up
  PYPLAYVNC_KEY=xxx pyplayvnc status
  PYPLAYVNC_KEY=xxx pyplayvnc open default https://mail.google.com
  PYPLAYVNC_KEY=xxx pyplayvnc kill default
  pyplayvnc down
HELP
        ;;
esac
